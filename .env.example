# Copy this file to .env and add your Google AI Studio key. Never commit .env.
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional SMTP settings for reminder emails.
# For Gmail, use smtp.gmail.com, port 587, and an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Daily .NET assignment email recipient and schedule.
DAILY_TRAINING_EMAIL=
DAILY_TRAINING_HOUR=8
DAILY_TRAINING_MINUTE=0
# Use "local" for the computer timezone or an IANA zone such as America/New_York.
DAILY_TRAINING_TIMEZONE=local